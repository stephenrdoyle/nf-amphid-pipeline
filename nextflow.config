/*
 * nf-helminth-amplicon configuration
 */

params {
    // inputs
    reference       = null
    samplesheet     = null
    runs            = null
    input_dir       = null
    run_id          = 'RUN01'
    platform        = null
    index_map       = "${projectDir}/assets/index_map.tsv"

    // Tandem copies of each index. 2 is the AMPSEQ design; 1 a conventional
    // single index at each end. Both are dual-index - the difference is
    // whether each index carries its own replicate, and so whether a frame
    // slip from an indel can be detected at all. null defers to the assay
    // config; a --runs manifest sets it per run.
    barcode_repeats = null

    // Assay definition: control tag, library construct, indexing design and
    // tolerances. Everything that makes this a particular assay lives here
    // rather than in code, so pointing the pipeline at a different panel or
    // construct is a file swap. Read by both Nextflow and preflight.py, so
    // the values are defined once.
    //
    // NOT configurable, deliberately: the sample_type and seq_type
    // vocabularies. The logic depends on them.
    assay           = "${projectDir}/assets/assay/ampseq_helminth.json"

    // One-off overrides. null means "use the assay config".
    tag_max_edits   = null
    expected_tag    = null

    // Optional inputs. Each is null when absent, and the module leaves the
    // flag off entirely rather than passing an empty value - so the tool's
    // own default decides, in one place.
    primers         = null
    mocks           = null
    comparison      = null

    // Read preparation (Illumina)
    min_length      = 100
    min_overlap     = 20
    max_ee          = 2.0

    // Demultiplexing (nanopore)
    max_mismatch    = 1
    include_failed  = false

    // Concatemer splitting (nanopore). Ligation joins amplicons into one
    // read; left whole, such a read carries one molecule's i5 and
    // another's i7 and demultiplexes into a well that held neither.
    anchor_max_edits = 2    // tolerance when locating adapter junctions
    min_unit_length  = 100  // pieces below this cannot carry an insert

    // Assignment
    max_dist_frac   = 0.10
    min_margin      = 2

    // Calling and run QC
    min_depth       = 100
    absolute_floor  = 2
    permutations    = 2000
    slope_tolerance = 0.15

    // Reporting
    min_composition_reads = 100
    // Regex stripped from sample_id to pair replicates across runs, e.g.
    // '-r[0-9]+$'. Null means pair on the id as given.
    replicate_suffix = null

    // Panel geometry checks that need to know the run configuration
    illumina_read_length = 250

    // output
    outdir          = './results'
    publish_dir_mode = 'copy'

    help            = false
}

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { fn -> fn == 'versions.yml' ? null : fn }
    ]

    errorStrategy = 'terminate'

    withName: PREFLIGHT       { publishDir = [ path: "${params.outdir}/preflight",   mode: params.publish_dir_mode ] }
    withName: PREP_ILLUMINA   { publishDir = [ path: "${params.outdir}/prep",        mode: params.publish_dir_mode ] }
    withName: DEMUX_ONT       { publishDir = [ path: "${params.outdir}/demux",       mode: params.publish_dir_mode ] }
    withName: ASSIGN          { publishDir = [ path: "${params.outdir}/assign",      mode: params.publish_dir_mode ] }
    withName: SYNTHESISE      { publishDir = [ path: "${params.outdir}/synthesis",   mode: params.publish_dir_mode ] }
    withName: CALIBRATE_MOCKS { publishDir = [ path: "${params.outdir}/calibration", mode: params.publish_dir_mode ] }
    withName: COMPARE_RUNS    { publishDir = [ path: "${params.outdir}/comparison",  mode: params.publish_dir_mode ] }
    withName: REPORT          { publishDir = [ path: "${params.outdir}",             mode: params.publish_dir_mode ] }

    withLabel: process_single {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
    }
    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = 6
        memory = 24.GB
        time   = 8.h
    }
}

profiles {

    // Development and optimisation. Also where near-term nanopore runs go,
    // since true offline field packaging is deferred.
    local {
        docker.enabled  = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor = 'local'
    }

    conda {
        conda.enabled   = true
        docker.enabled  = false
    }

    // Routine Illumina work on the farm.
    farm {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process {
            executor = 'lsf'
            queue    = 'normal'
        }
        executor {
            perJobMemLimit = true
            queueSize      = 200
        }
    }

    // Minimal smoke test: runs pre-flight on the generated fixtures.
    test {
        params.reference   = "${projectDir}/tests/data/reference.tsv"
        params.samplesheet = "${projectDir}/tests/data/samplesheet.csv"
        params.runs        = "${projectDir}/tests/data/runs.tsv"
        params.primers     = "${projectDir}/tests/data/primers.tsv"
        params.outdir      = './results-test'
        // Small on purpose: enough wells to exercise both the plate
        // sensors and the blanks, few enough to finish on a laptop.
        params.permutations = 200
    }

    debug {
        process.beforeScript = 'echo $HOSTNAME'
        cleanup = false
    }
}

// Containers must not inherit the host's thread limits, or a process sized
// for one core quietly uses all of them.
env {
    PYTHONNOUSERSITE = 1
    OMP_NUM_THREADS  = 1
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }

manifest {
    name            = 'nf-helminth-amplicon'
    description     = 'Amplicon panel analysis with spike-in quantification and tagged control plasmids, for Illumina and nanopore'
    author          = 'Stephen Doyle'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0dev'
}
