/*
 * nf-helminth-amplicon configuration
 */

params {
    // inputs
    reference       = null
    samplesheet     = null
    primers         = null   // required: the trimmed panel is built from it
    runs            = null
    input_dir       = null
    run_id          = 'RUN01'
    platform        = null
    index_map       = "${projectDir}/assets/index_map.tsv"

    // Tandem copies of each index. 2 is the AMPSEQ design; 1 a conventional
    // single index at each end. Both are dual-index - the difference is
    // whether each index carries its own replicate, and so whether a frame
    // slip from an indel can be detected at all. null defers to the assay
    // config; a --runs manifest sets it per run.
    barcode_repeats = null

    // Assay definition: control tag, library construct, indexing design and
    // tolerances. Everything that makes this a particular assay lives here
    // rather than in code, so pointing the pipeline at a different panel or
    // construct is a file swap. Read by both Nextflow and preflight.py, so
    // the values are defined once.
    //
    // NOT configurable, deliberately: the sample_type and seq_type
    // vocabularies. The logic depends on them.
    assay           = "${projectDir}/assets/assay/ampseq_helminth.json"

    // Require the indices a nanopore run uses to be at least this far
    // apart in EDIT distance, and fail pre-flight if they are not.
    // null reports the shortfall without blocking: an existing plate
    // cannot be changed, so refusing to analyse reads already on disk
    // helps nobody. Set it to 3 when designing a NEW plate, where the
    // guarantee is worth having up front.
    min_index_edit  = null

    // One-off overrides. null means "use the assay config".
    tag_max_edits   = null
    expected_tag    = null

    // Optional inputs. Each is null when absent, and the module leaves the
    // flag off entirely rather than passing an empty value - so the tool's
    // own default decides, in one place.
    mocks           = null
    metadata        = null
    comparison      = null

    // Read preparation (Illumina)
    min_length      = 100
    min_overlap     = 20
    max_ee          = 2.0

    // Demultiplexing (nanopore)
    max_mismatch    = 1
    include_failed  = false

    // Concatemer splitting (nanopore). Ligation joins amplicons into one
    // read; left whole, such a read carries one molecule's i5 and
    // another's i7 and demultiplexes into a well that held neither.
    anchor_max_edits = 2    // tolerance when locating adapter junctions
    min_unit_length  = 100  // pieces below this cannot carry an insert

    // Assignment
    max_dist_frac   = 0.10
    min_margin      = 2

    // Control plasmids. By default they are contamination and their share
    // of each well is reported; set controls_as_targets on a run whose
    // subject IS the plasmids - a titration or a mock - to give them
    // detection calls too. The proportions are emitted either way.
    controls_as_targets = false
    plasmid_warn        = 0.05

    // Calling and run QC
    // The quantification standards were added to every sample. Off by
    // default: an unspiked run gives presence/absence calls with
    // unverified negatives and no copy numbers. --spiked calibrates each
    // well against its standards and treats a well missing them as
    // failed. Declared rather than inferred, because the reads can only
    // guess, and the guess fails both on a run whose spikes mostly
    // failed and on one with widespread carryover.
    spiked          = false
    min_depth       = 100
    absolute_floor  = 2
    permutations    = 2000
    slope_tolerance = 0.15

    // Reporting
    min_composition_reads = 100
    // Regex stripped from sample_id to pair replicates across runs, e.g.
    // '-r[0-9]+$'. Null means pair on the id as given.
    replicate_suffix = null

    // Panel geometry checks that need to know the run configuration
    illumina_read_length = 250

    // output
    outdir          = './results'
    publish_dir_mode = 'copy'

    help            = false
}

// ---------------------------------------------------------------------------
// Executor. LSF is the DEFAULT, not opt-in.
// ---------------------------------------------------------------------------
// A bare `nextflow run` submits to the farm, and `-profile local` or
// `-profile stub` is the explicit opt-out. The alternative - LSF hidden
// behind a profile - means every forgotten flag silently runs the whole
// cohort on the head node, or fails there for want of memory. That
// happened twice on the first day this workflow was executed.
process.executor = 'lsf'

executor {
    queueSize       = 1000
    submitRateLimit = '200/1min'
    pollInterval    = '30 sec'
    // farm22 wants -M and rusage[mem=] to agree exactly.
    perJobMemLimit  = true
}

def localCpus = Runtime.runtime.availableProcessors()

process {
    // Publish to the output root and let each file's own relative path
    // place it. Every tool already writes into a named subdirectory -
    // preflight/, split/, demux/, assign/, synthesis/ - and those names
    // ARE the intended layout, so adding the same name again to the
    // publishDir gave results/synthesis/synthesis/calls.tsv.
    publishDir = [
        path: { params.outdir },
        mode: params.publish_dir_mode,
        saveAs: { fn -> fn == 'versions.yml' ? null : fn }
    ]

    // Lustre timestamps and sizes are not always trustworthy, and a
    // strict cache invalidates work that is perfectly good.
    cache = 'lenient'

    // Avoid nodes that are already saturated.
    clusterOptions = { "-R \"select[ut<1.0]\"" }

    // Retry what is transient; stop on what is not.
    //
    // A lustre transport drop, an eviction or an OOM is worth another
    // attempt with more memory. A tool that exited non-zero because the
    // data is wrong is not, and must NOT be ignored: this pipeline fans
    // out one ASSIGN task per sample, so an ignored failure would remove
    // a well from the cohort and let synthesis report confidently on the
    // remainder. Silent loss of a sample is the exact failure the read
    // accounting exists to prevent, so the run stops instead.
    errorStrategy = {
        if (task.exitStatus == null || task.exitStatus == -1) return 'retry'
        if (task.exitStatus in [130, 134, 135, 137, 139, 140, 143, 250]) return 'retry'
        return 'terminate'
    }
    maxRetries = 3


    // Memory scales with the attempt, so a well that needs more gets it
    // rather than failing the run.
    withLabel: process_single {
        queue  = 'normal'
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel: process_low {
        queue  = 'normal'
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    // One shard of a fanned-out stage: exactly one input file, so
    // exactly one core. The tool divides work BY INPUT FILE, which
    // means a second core here would have nothing to do - and asking
    // for cores that sit idle is not merely wasteful on a shared farm,
    // it is slower, because LSF places a 1-core job into whatever gap
    // exists now and a 16-core job only when a node frees up. Memory
    // is flat at ~30 MB whatever the file size, so 2 GB is headroom
    // rather than need.
    withLabel: process_shard {
        queue  = { task.attempt <= 2 ? 'normal' : 'long' }
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    // Splitting and demultiplexing. Both hold memory flat at ~30 MB
    // whatever the run size, so this is headroom rather than need; the
    // cores are what matter, since both shard by input file.
    withLabel: process_medium {
        queue  = { task.attempt <= 2 ? 'normal' : 'long' }
        cpus   = 16
        memory = { 8.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}

profiles {

    // Explicit opt-out from LSF, for a laptop or the head node. Not for
    // real runs.
    local {
        process.executor = 'local'
        process {
            clusterOptions = null
            queue = null
            withLabel: process_single { cpus = 1; memory = 2.GB }
            withLabel: process_shard  { cpus = 1; memory = 2.GB }
            withLabel: process_low    { cpus = { Math.min(2, localCpus) }; memory = 4.GB }
            withLabel: process_medium { cpus = { Math.min(6, localCpus) }; memory = 8.GB }
        }
    }

    // Prove the DAG connects without doing any work. Stub tasks write
    // placeholder files, so they need one core and a moment. Each label
    // is named because withLabel selectors take precedence over the
    // generic process block - setting cpus there alone is silently
    // overridden.
    stub {
        process.executor = 'local'
        process {
            clusterOptions = null
            queue = null
            withLabel: process_single { cpus = 1; memory = 1.GB; time = 10.m }
            withLabel: process_shard  { cpus = 1; memory = 1.GB; time = 10.m }
            withLabel: process_low    { cpus = 1; memory = 1.GB; time = 10.m }
            withLabel: process_medium { cpus = 1; memory = 1.GB; time = 10.m }
        }
    }

    // Every tool here is standard-library Python 3 with no third-party
    // imports, so nothing needs installing and no container is required.
    // The modules still declare one, used only if an engine is enabled
    // here - a reproducibility choice, not a dependency.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    conda { conda.enabled = true }

    // Kept so existing `-profile farm` commands still work. LSF is now
    // the default, so this asks for nothing extra.
    farm { }

    // Minimal smoke test on the generated fixtures.
    test {
        params.reference   = "${projectDir}/tests/data/reference.tsv"
        params.samplesheet = "${projectDir}/tests/data/samplesheet.tsv"
        params.runs        = "${projectDir}/tests/data/runs.tsv"
        params.primers     = "${projectDir}/tests/data/primers.tsv"
        // Library-level, so the fixture exercises the grouping a
        // subject-keyed file cannot express.
        params.metadata    = "${projectDir}/tests/data/metadata.tsv"
        params.outdir      = './results-test'
        // Small on purpose: enough wells to exercise both the plate
        // sensors and the blanks, few enough to finish on a laptop.
        params.permutations = 200
        // The simulated fixtures carry the standards, so the test runs
        // the spiked path: calibration, copies and failed-spike calls.
        params.spiked       = true
    }

    // The nanopore branch. Separate from `test` rather than folded
    // into it because the two exercise different halves of main.nf and
    // a failure should say which. Generated by
    // tests/make_ont_fixture.py, which deliberately writes SEVERAL
    // MinKNOW batch files: splitting now fans out one task per input
    // file, and a single-file fixture would test a fan-out of one.
    test_ont {
        params.reference   = "${projectDir}/tests/data/ont/reference.tsv"
        params.samplesheet = "${projectDir}/tests/data/ont/samplesheet.tsv"
        params.runs        = "${projectDir}/tests/data/ont/runs.tsv"
        params.primers     = "${projectDir}/tests/data/ont/primers.tsv"
        params.metadata    = "${projectDir}/tests/data/ont/metadata.tsv"
        params.outdir      = './results-test-ont'
        params.permutations = 200
        // The fixture is small, so the default depth floor would call
        // every well assay_failed and the run would prove nothing.
        params.min_depth   = 10
        params.spiked      = true
    }

    debug {
        process.beforeScript = 'echo $HOSTNAME'
        cleanup = false
    }
}

// Containers must not inherit the host's thread limits, or a process sized
// for one core quietly uses all of them.
env {
    PYTHONNOUSERSITE = 1
    OMP_NUM_THREADS  = 1
}

// overwrite = true, or a second run into the same --outdir fails to
// render these and warns about it without saying why.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }

manifest {
    name            = 'nf-helminth-amplicon'
    description     = 'Amplicon panel analysis with spike-in quantification and tagged control plasmids, for Illumina and nanopore'
    author          = 'Stephen Doyle'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0dev'
}
